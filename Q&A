":1785347068638,"user_tz":-330,"elapsed":18,"user":{"displayName":"Bhushan Pol","userId":"15922165146157395783"}}},"source":["import pandas as pd\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","\n","# Helper function to detect outliers using the IQR method\n","def detect_outliers_iqr(series):\n","    Q1 = series.quantile(0.25)\n","    Q3 = series.quantile(0.75)\n","    IQR = Q3 - Q1\n","    lower_bound = Q1 - 1.5 * IQR\n","    upper_bound = Q3 + 1.5 * IQR\n","    outliers = series[(series < lower_bound) | (series > upper_bound)]\n","    return outliers\n","\n","def perform_full_eda(df, target_column=None, corr_threshold=0.7):\n","    \"\"\"\n","    Performs a full Exploratory Data Analysis (EDA) on a given DataFrame.\n","\n","    Args:\n","        df (pd.DataFrame): The input DataFrame.\n","        target_column (str, optional): The name of the target column to analyze correlations against.\n","                                       Defaults to None.\n","        corr_threshold (float, optional): Absolute correlation threshold to identify highly correlated pairs.\n","                                          Defaults to 0.7.\n","    \"\"\"\n","    print(\"--- Starting Exploratory Data Analysis ---\")\n","\n","    # 1. Basic Data Exploration\n","    print(\"\\n--- 1. Basic Data Exploration ---\")\n","    print(\"\\nDataFrame Head:\")\n","    display(df.head())\n","    print(f\"\\nDataFrame Shape: {df.shape[0]} rows, {df.shape[1]} columns\")\n","    print(\"\\nDataFrame Info:\")\n","    df.info()\n","    print(\"\\nMissing Values:\")\n","    display(df.isnull().sum())\n","    print(\"\\nDescriptive Statistics for Numerical Features:\")\n","    display(df.describe())\n","\n","    # Identify numerical features\n","    numerical_features = df.select_dtypes(include=np.number).columns.tolist()\n","    if not numerical_features:\n","        print(\"\\nNo numerical features found for correlation and distribution analysis.\")\n","        print(\"--- EDA Complete ---\")\n","        return\n","\n","    # 2. Correlation Analysis\n","    print(\"\\n--- 2. Correlation Analysis ---\")\n","    correlation_matrix = df[numerical_features].corr()\n","    print(\"\\nCorrelation Matrix:\")\n","    display(correlation_matrix)\n","\n","    plt.figure(figsize=(10, 8))\n","    sns.heatmap(correlation_matrix, annot=True, cmap='coolwarm', fmt=\".2f\")\n","    plt.title('Correlation Matrix Heatmap')\n","    plt.show()\n","\n","    print(f\"\\nHighly Correlated Pairs (absolute correlation > {corr_threshold}):\")\n","    high_corr_pairs = []\n","    for i in range(len(correlation_matrix.columns)):\n","        for j in range(i + 1, len(correlation_matrix.columns)): # Avoid self-correlation and duplicates\n","            if abs(correlation_matrix.iloc[i, j]) > corr_threshold:\n","                pair = (correlation_matrix.columns[i], correlation_matrix.columns[j], correlation_matrix.iloc[i, j])\n","                high_corr_pairs.append(pair)\n","    if high_corr_pairs:\n","        for pair in high_corr_pairs:\n","            print(f\"  {pair[0]} - {pair[1]}: {pair[2]:.2f}\")\n","    else:\n","        print(\"  No highly correlated pairs found.\")\n","\n","    if target_column and target_column in df.columns:\n","        if pd.api.types.is_numeric_dtype(df[target_column]):\n","            print(f\"\\nCorrelation of features with '{target_column}' (absolute correlation > {corr_threshold}):\")\n","            # Calculate correlation of all numerical features with the target, excluding the target itself\n","            target_corrs = df.select_dtypes(include=np.number).corr()[target_column].drop(target_column, errors='ignore')\n","            display(target_corrs[abs(target_corrs) > corr_threshold].sort_values(ascending=False))\n","        else:\n","            print(f\"\\nTarget column '{target_column}' is not numerical, skipping correlation with features.\")\n","\n","    # 3. Distribution Analysis\n","    print(\"\\n--- 3. Distribution Analysis ---\")\n","    print(\"\\nHistograms (Distribution Plots):\")\n","    n_cols = len(numerical_features)\n","    n_rows = (n_cols + 1) // 2 # Max 2 plots per row\n","    plt.figure(figsize=(15, 5 * n_rows))\n","    for i, col in enumerate(numerical_features):\n","        plt.subplot(n_rows, 2, i + 1)\n","        sns.histplot(df[col].dropna(), kde=True)\n","        plt.title(f'Distribution of {col}')\n","        plt.xlabel(col)\n","        plt.ylabel('Frequency')\n","    plt.tight_layout()\n","    plt.show()\n","\n","    print(\"\\nBoxplots (Outlier Visualization):\")\n","    plt.figure(figsize=(15, 5 * n_rows))\n","    for i, col in enumerate(numerical_features):\n","        plt.subplot(n_rows, 2, i + 1)\n","        sns.boxplot(y=df[col].dropna())\n","        plt.title(f'Boxplot of {col}')\n","        plt.ylabel(col)\n","    plt.tight_layout()\n","    plt.show()\n","\n","    print(\"\\nSkewness of Numerical Features:\")\n","    skewness_values = df[numerical_features].skew()\n","    display(skewness_values)\n","\n","    print(\"\\nOutlier Counts (IQR Method):\")\n","    outlier_summary = []\n","    for col in numerical_features:\n","        outliers = detect_outliers_iqr(df[col].dropna())\n","        outlier_summary.append({'Feature': col, 'Outlier Count': len(outliers)})\n","    display(pd.DataFrame(outlier_summary))\n","\n","    print(\"--- EDA Complete ---\")\n"],"execution_count":43,"outputs":[]},{"cell_type":"markdown","metadata":{"id":"0de9e93f"},"source":["Now, let's run the `perform_full_eda` function on our DataFrame, considering 'rainfall' as a potential target variable."]},{"cell_type":"code","metadata":{"id":"741d4a16"},"source":["# Example usage of the EDA function\n","perform_full_eda(df.copy(), target_column='rainfall')"],"execution_count":null,"outputs":[]}]}